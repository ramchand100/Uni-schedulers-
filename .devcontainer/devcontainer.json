{
  "name": "Uni Schedulers (Expo)",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:20",
  "forwardPorts": [8081, 19000, 19001, 19002],
  "portsAttributes": {
    "8081": { "label": "Metro Bundler", "onAutoForward": "notify" },
    "19000": { "label": "Expo Dev Tools", "onAutoForward": "notify" }
  },
  "postCreateCommand": "npm install && npm install --no-save @expo/ngrok@^4.1.0"
}
